#!/usr/bin/env node
/**
 * `blastradius` entry point.
 *
 * Works the same whether this is a clone or an npm install, because those two
 * have different layouts and the command in the README has to be the command
 * you actually run:
 *
 *   npx blast-radius            -> published bundle at dist/blastradius.mjs
 *   npm i -g blast-radius       -> same bundle, on PATH
 *   ./bin/blastradius           -> straight from a clone, workspace build
 *
 * The published tarball carries the bundle; a clone carries the workspace
 * build. Whichever exists is used, and the error names both rather than
 * leaving the reader to guess which half is missing.
 */
import { existsSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));

const candidates = [
  resolve(here, '../dist/blastradius.mjs'), // published bundle
  resolve(here, '../packages/cli/dist/index.js'), // clone, after `npm run build`
];

const entry = candidates.find((candidate) => existsSync(candidate));

if (!entry) {
  process.stderr.write(
    'blastradius: no build found.\n\n' +
      'From a clone, build it first:\n' +
      '  npm install && npm run build\n\n' +
      'If this came from npm, the tarball is missing dist/blastradius.mjs — ' +
      'please report it.\n',
  );
  process.exit(1);
}

await import(pathToFileURL(entry).href);
