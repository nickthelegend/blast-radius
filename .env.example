# ---------------------------------------------------------------------------
# Blast Radius configuration. Copy to `.env` and edit.
# Every tunable the project reads is documented here.
# ---------------------------------------------------------------------------

# --- HydraDB connection -----------------------------------------------------
# HTTP JSON/NDJSON query API exposed by graph-node.
HYDRA_HTTP_URL=http://127.0.0.1:8443
# Bolt endpoint (Neo4j-compatible). Used by `blastradius doctor --bolt`.
HYDRA_BOLT_URL=neo4j://127.0.0.1:7687
# Admin/readiness/metrics endpoint.
HYDRA_ADMIN_URL=http://127.0.0.1:9090
# Bearer token. Must be >= 32 non-placeholder characters (HydraDB enforces this).
HYDRA_AUTH_TOKEN=local-development-token-32-bytes
# Graph coordinates. These must match the graph-node container's env.
HYDRA_NAMESPACE=default
HYDRA_GRAPH_ID=default
HYDRA_CELL_ID=cell-0
# Per-request timeout in milliseconds.
HYDRA_TIMEOUT_MS=30000

# --- Traversal tuning -------------------------------------------------------
# Maximum dependency-chain depth for blast-radius traversal (RESOLVED_TO hops).
# The engine caps total path length at max_traversal_hops (default 16); Blast
# Radius spends 2 of those on the trailing RESOLVED + HAS_SNAPSHOT hops, so the
# effective ceiling for this value is 14.
BLAST_MAX_DEPTH=8
# Total path budget handed to algo.SSpaths / algo.MSpaths via `pathCount`.
# IMPORTANT: pathCount is a TOTAL budget, not a per-target one, and it defaults
# to 1 inside HydraDB. A low value silently truncates the blast radius.
BLAST_PATH_COUNT=20000
# Hard cap on rows returned by a single path procedure call (`resultLimit`).
BLAST_RESULT_LIMIT=20000
# Read consistency for ordinary queries: causal | strong
BLAST_READ_CONSISTENCY=causal
# Read consistency used when the "verified" toggle is on (Time Machine).
BLAST_VERIFIED_CONSISTENCY=strong

# --- Typosquat detection ----------------------------------------------------
# Maximum Levenshtein distance for a NAME_SIMILAR_TO edge.
TYPOSQUAT_MAX_DISTANCE=2
# Only compare against this many of the org's most-depended-on packages.
TYPOSQUAT_TOP_N=150
# Names shorter than this are skipped (too many false positives).
TYPOSQUAT_MIN_NAME_LENGTH=4
# A package published more recently than this many days is treated as higher
# risk when it is a near-match for a trusted dependency.
TYPOSQUAT_RECENT_DAYS=90
# Weekly downloads below this threshold escalate a near-match to SUSPICIOUS.
TYPOSQUAT_LOW_DOWNLOAD_THRESHOLD=1000
# Registry search results to pull per trusted package when hunting for
# near-name candidates. The dependency crawl only reaches packages that are
# legitimately depended on, so real squats have to be searched for.
TYPOSQUAT_SEARCH_SIZE=20

# --- Ingestion --------------------------------------------------------------
# Ecosystem selection: npm | pypi | npm,pypi
INGEST_ECOSYSTEMS=npm
# Number of seed packages taken from the curated top-dependents list.
INGEST_SEED_COUNT=300
# How deep to follow transitive dependencies from each seed.
INGEST_MAX_DEPTH=2
# Fetch full packuments up to this depth; deeper packages use the abbreviated
# document. Full packuments are the only source of per-version publish times
# and maintainer lists, but they are huge (typescript's is 15MB because it
# embeds every version's README) — so by default only the seeds get one. The
# seeds are the org's direct dependencies, which are the packages the
# Maintainer Web and version timelines actually ask about.
INGEST_FULL_METADATA_DEPTH=0
# Every retained version becomes a node, but only the newest N of each package
# get resolved dependency edges. Edge count, not node count, drives traversal
# cost, so this is the main lever on graph density.
INGEST_RESOLVE_VERSIONS=4
# Query OSV.dev for advisories on this many of the most-depended-on packages.
INGEST_ADVISORY_PACKAGES=250
# Concurrent registry requests.
INGEST_CONCURRENCY=12
# Retain at most this many recent versions per package (keeps the graph sane).
INGEST_MAX_VERSIONS_PER_PACKAGE=12
# Registry endpoints.
NPM_REGISTRY_URL=https://registry.npmjs.org
NPM_DOWNLOADS_API=https://api.npmjs.org
PYPI_REGISTRY_URL=https://pypi.org
OSV_API_URL=https://api.osv.dev
# Set to 1 to forbid all network access and use only the vendored snapshot.
BLAST_OFFLINE=0

# --- Synthetic organization -------------------------------------------------
# The org layered on top of the real package graph.
ORG_NAME=acme-corp
ORG_REPO_COUNT=18
# Lockfile snapshots generated per repo, spread across the simulated timeline.
ORG_SNAPSHOTS_PER_REPO=6
# Deterministic seed so `make demo` produces an identical graph every run.
ORG_RANDOM_SEED=20260814
# The simulated "now" the generated lockfile history runs up to. Fixed by
# default so the committed snapshot, the README's example output and the demo
# scenario's 09:00-09:06 window all agree.
ORG_SIMULATED_NOW=2026-08-14T12:00:00Z
# Direct dependencies per repo.
ORG_DIRECT_DEPS_MIN=4
ORG_DIRECT_DEPS_MAX=12
# Cap on resolved entries recorded per lockfile snapshot.
ORG_MAX_LOCKFILE_ENTRIES=400

# --- API server / dashboard -------------------------------------------------
BLAST_API_PORT=4000
BLAST_DASHBOARD_PORT=5173
